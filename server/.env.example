# Sokoban Mutante — community server config
# (todo es opcional; defaults razonables para LAN)

# Fichero SQLite (default: server/community.db)
#SKM_DB=/path/to/community.db

# Catálogo máximo (los más nuevos) — default 5000
#SKM_MAX_ENTRIES=5000

# Mutaciones por IP y minuto — default 30
#SKM_RATE_MAX=30

# Caducidad de sesión Bearer en días (renovación deslizante) — 30
#SKM_SESSION_DAYS=30

# Cuentas con moderación: pueden borrar cualquier entrada y ver
# /api/stats — csv de usernames
#SKM_ADMINS=admin,moderator

# TLS nativo (ambos o ninguno): https:// sin proxy
#SKM_TLS_CERT=/path/fullchain.pem
#SKM_TLS_KEY=/path/privkey.pem
