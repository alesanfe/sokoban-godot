# Sokoban Mutante — variables de entorno del servidor de comunidad
# Copiar a .env solo si se necesita sobreescribir los defaults.

# Base de datos SQLite (default: server/community.db)
SKM_DB=server/community.db

# Rate limit: POSTs por minuto por IP (default 30)
SKM_RATE_MAX=30

# Niveles máximos en el leaderboard (default 5000)
SKM_MAX_ENTRIES=5000

# TTL de sesión en días (default 30)
SKM_SESSION_DAYS=30

# Usernames admin, separados por comas (default: ninguno)
# SKM_ADMINS=alice,bob

# TLS: rutas al certificado y clave (vacío = HTTP plano)
SKM_TLS_CERT=
SKM_TLS_KEY=
