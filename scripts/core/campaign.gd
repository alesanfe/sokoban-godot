class_name Campaign
extends RefCounted
## Built-in campaign: introduces each absurd rule progressively,
## then combines them.


static func levels() -> Array:
	var out: Array = []
	for def in _defs():
		var l := LevelData.create(def[0], PackedStringArray(def[1]), def[2] if def.size() > 2 else [], "Campaña")
		if def.size() > 3:
			l.par = def[3]
		if def.size() > 4:
			l.hidden_rules = def[4]
		out.append(l)
	return out


